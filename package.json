{
  "name": "EmployeeManagement",
  "version": "1.0.0",
  "description": "Employee Management Application using CAPM",
  "license": "ISC",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10.1.1",
    "express": "^5.2",
    "sqlite3": "^6.0.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "run": "cds run",
    "watch": "cds watch",
    "watch-employee-ui": "cds watch --open com.visulapth.employeeui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "employee-user": {
              "password": "User123",
              "roles": [
                "User"
              ]
            },
            "employee-admin": {
              "password": "Admin123",
              "roles": [
                "Admin"
              ]
            }
          }
        }
      },
      "db": {
        "kind": "sqlite"
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/employee-ui"
  ]
}

{
  "name": "EmployeeManagement",
  "version": "1.0.0",
  "description": "Employee Management Application using CAPM",
  "license": "ISC",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10.1.1",
    "express": "^5.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "run": "cds run",
    "watch": "cds watch",
    "watch-employee-ui": "cds watch --open com.visulapth.employeeui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/employee-ui"
  ]
}

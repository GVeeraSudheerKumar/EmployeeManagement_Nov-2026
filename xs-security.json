{
  "xsappname": "EmployeeManagement-174095d2trial-dev",
  "tenant-mode": "dedicated",
  "oauth2-configuration": {
    "redirect-uris": [
      "https://174095d2trial-dev-employeemanagement-ui.cfapps.us10-001.hana.ondemand.com/login/callback"
    ]
  },
  "scopes": [
    {
      "name": "$XSAPPNAME.User",
      "description": "Employee Management User"
    },
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Employee Management Admin"
    }
  ],
  "role-templates": [
    {
      "name": "User",
      "description": "Employee Management User",
      "default-role-name": "User: Authorized to Read All Data",
      "scope-references": [
        "$XSAPPNAME.User"
      ]
    },
    {
      "name": "Admin",
      "description": "Edit, delete, Approve, Reject Employee Management",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ]
    }
  ]
}